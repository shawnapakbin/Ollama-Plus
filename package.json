{
  "name": "ollama-plus",
  "private": true,
  "version": "5.0.2",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "release:check": "node scripts/release-readiness.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:debug": "cross-env ELECTRON_REMOTE_DEBUGGING_PORT=9222 node scripts/electron-dev.mjs",
    "preflight:electron:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-electron-win-prereqs.ps1",
    "electron:build:checked": "npm run preflight:electron:win && npm run electron:build",
    "electron:build": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.ollama.nativeapp",
    "productName": "Ollama +",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "mcp/lib/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ollama+",
      "menuCategory": "Ollama+",
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Ollama + ${version}",
      "packElevateHelper": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "compression": "maximum",
    "publish": {
      "provider": "generic",
      "url": "${env.UPDATE_SERVER_URL}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "lucide-react": "^1.30.0",
    "playwright-core": "^1.63.0-alpha-2026-08-05",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.79",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fast-check": "^4.9.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
