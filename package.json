{
  "name": "ollama-plus",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron .\"",
    "electron:debug": "concurrently -k \"cross-env BROWSER=none vite --port 5173 --strictPort\" \"wait-on tcp:5173 && electron . --remote-debugging-port=9222\"",
    "electron:build": "npm run build && electron-builder",
    "mcp:folder": "node mcp/folder-server.mjs",
    "mcp:terminal": "node mcp/terminal-server.mjs",
    "mcp:python": "node mcp/python-sandbox-server.mjs",
    "mcp:datetime": "node mcp/datetime-server.mjs",
    "mcp:calculator": "node mcp/calculator-server.mjs"
  },
  "build": {
    "appId": "com.ollama.nativeapp",
    "productName": "Ollama +",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@types/three": "^0.184.1",
    "csv-parse": "^6.2.1",
    "lucide-react": "^1.14.0",
    "mathjs": "^15.2.0",
    "node-pty": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.59.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.5"
  }
}
