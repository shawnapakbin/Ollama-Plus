LLAMA_HOST=0.0.0.0
LLAMA_PORT=8000

LLAMA_BIN=/opt/llama.cpp/bin/llama-server
LLAMA_MODEL=/home/shawna/models/hf/qwen3-coder-next-q5_k_m/Qwen3-Coder-Next-Q5_K_M/Qwen3-Coder-Next-Q5_K_M-00001-of-00004.gguf

LLAMA_CTX=262144
LLAMA_THREADS=32
LLAMA_PARALLEL=2
LLAMA_NGL=999
LLAMA_BATCH=2048
LLAMA_UBATCH=512
LLAMA_CONT_BATCHING=1
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_TENSOR_SPLIT=1,1,1,1,1

LLAMA_EXTRA_ARGS="--jinja --metrics --slots --temp 0.3 --alias openhands-default,qwen3-coder-next,qwen3-coder --reasoning off"

LLAMA_SYSTEM_PROMPT_FILE=/etc/llama.cpp/system-prompt.txt
LLAMA_HEALTH_PATH=/health
LLAMA_TEMP_WARN_C=85
